# Database
DATABASE_URL="file:./dev.db"   # SQLite for dev; postgres://... for prod

# AI provider — Google Gemini (primary, free tier via AI Studio)
GEMINI_API_KEY=""
# Optional fallbacks, tried in order only when the previous provider fails.
# Leave blank to skip. OpenAI = gpt-4o-mini, Groq = llama-3.1-8b-instant.
OPENAI_API_KEY=""
GROQ_API_KEY=""

# SMTP — personal Gmail with app password (requires 2FA)
SMTP_USER=""
SMTP_APP_PASSWORD=""

# Comma-separated list of emails that will receive REAL sends.
# Everything else is recorded as simulated to protect Gmail sender reputation.
ALLOWED_TEST_RECIPIENTS="dev@example.com,tester@example.com"
